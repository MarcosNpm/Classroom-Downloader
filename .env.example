# Este archivo es una referencia: la app NO lo carga automáticamente.
# Exporta las variables en tu shell (o en el cron) antes de ejecutar classroom-dl:
#   export CLASSROOM_DL_CREDENTIALS=...
#   export CLASSROOM_DL_OUTPUT=...

# Ruta al client_secret.json descargado de Google Cloud Console.
# Por defecto la app busca en ~/.config/classroom-dl/client_secret.json
CLASSROOM_DL_CREDENTIALS=/home/tu-usuario/.config/classroom-dl/client_secret.json

# Carpeta donde se guardan las descargas (por defecto ~/Classroom)
CLASSROOM_DL_OUTPUT=/home/tu-usuario/Classroom

# Ruta alternativa del token OAuth (por defecto ~/.config/classroom-dl/token.json)
# CLASSROOM_DL_TOKEN=/home/tu-usuario/.config/classroom-dl/token.json
